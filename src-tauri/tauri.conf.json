{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LaundryKu",
  "version": "1.0.0",
  "identifier": "com.laundryku.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:laundryku.db"]
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LaundryKu",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "LaundryKu",
    "homepage": "https://github.com/Mukhamadirfan1997/LAUNDRYKU",
    "copyright": "Copyright © 2026 LaundryKu",
    "category": "Business",
    "shortDescription": "Manajemen keuangan usaha laundry",
    "longDescription": "LaundryKu membantu mencatat order, pembayaran, pengeluaran, dan laporan keuangan usaha laundry secara offline. Data tersimpan lokal dengan backup dan restore.",
    "licenseFile": "installer/LICENSE.rtf",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Indonesian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "uninstallerHeaderImage": "installer/nsis-header.bmp",
        "startMenuFolder": "LaundryKu",
        "compression": "lzma"
      },
      "wix": {
        "language": "en-US",
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
